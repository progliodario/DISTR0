# DISTR0 system defaults.
# Files in /etc/dconf/db/distro.d are merged into the same database Bluefin
# writes to; this one is numbered last so its keys win over 01-..08-.

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/distr0/distr0-wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/distr0/distr0-wallpaper.png'
picture-options='zoom'
primary-color='#070a18'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/distr0/distr0-wallpaper.png'
picture-options='zoom'
primary-color='#070a18'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'it')]
