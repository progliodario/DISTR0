{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/distr0/ascii-logo.txt",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "os",
    "kernel",
    "de",
    "packages",
    "shell",
    "terminal",
    "uptime",
    "memory"
  ]
}
