# CLI tools installed by DISTR0 through Bluefin's brew-preinstall.service on
# first boot (and re-synced on every OS update). Packages already listed in
# Bluefin's own preinstall.d/system-cli.Brewfile are deliberately not repeated.
# `ujust distr0-cli` installs this list on demand.
brew "bottom"
brew "dust"
brew "lazygit"
brew "xh"
